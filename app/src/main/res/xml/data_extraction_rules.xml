<?xml version="1.0" encoding="utf-8"?>
<!-- The pets, treatments and document photos follow the user to a new phone (Google backup / transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
